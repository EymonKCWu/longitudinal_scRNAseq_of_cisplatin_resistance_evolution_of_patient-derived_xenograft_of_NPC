library(DoubletFinder)

#xeno76_ctrl
pc.num <- 1:20
DoubletRate = 0.05 
sweep.res <- paramSweep(xeno76_ctrl, PCs = pc.num, sct = F) 
sweep.stats <- summarizeSweep(sweep.res, GT = FALSE)
bcmvn <- find.pK(sweep.stats)
pK_bcmvn <- bcmvn$pK[which.max(bcmvn$BCmetric)] %>% as.character() %>% as.numeric()
homotypic.prop <- modelHomotypic(xeno76.combined_fastmnn_reintegrated_split[["xeno76_ctrl"]]$seurat_clusters)   
nExp_poi <- round(DoubletRate * ncol(xeno76.combined_fastmnn_reintegrated_split[["xeno76_ctrl"]]))
nExp_poi.adj <- round(nExp_poi * (1 - homotypic.prop))
xeno76_ctrl <- doubletFinder(xeno76_ctrl, 
                                  PCs = pc.num,
                                  pK = pK_bcmvn, 
                                  nExp = nExp_poi.adj, 
                                  sct = F)
df <- xeno76_ctrl@meta.data
row_names <- rownames(df)
rownames(df) <- paste("xeno76_ctrl", rownames(df), sep = "_")
classification_cols <- grep("DF.classifications", colnames(df), value = TRUE)
xeno76_ctrl.doublet_result <- df[, classification_cols, drop = FALSE]

